{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jnton.github.io/Questionnaire-of-Cognitive-and-Affective-Empathy-QCAE-online-questionnaire/data/results.schema.json",
  "title": "QCAE result export",
  "type": "object",
  "required": [
    "instrument",
    "instrumentVersion",
    "scoreModel",
    "locale",
    "completedAt",
    "provenance",
    "scores",
    "responses"
  ],
  "properties": {
    "instrument": {
      "const": "qcae"
    },
    "locale": {
      "type": "string"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "scores": {
      "type": "object"
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "itemId",
          "response",
          "scoredValue",
          "reverseScored",
          "subscale",
          "text"
        ]
      }
    },
    "instrumentVersion": {
      "type": "string"
    },
    "scoreModel": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "required": [
        "variantStatus",
        "referenceIds",
        "implementation",
        "implementationVersion"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
